class BufferBlock:
    def __init__(self, slot_id: int, transport: str, endpoint: str, seq: int, payload_bytes: int, ts: float, pinned: bool = False):
        self.slot_id = slot_id
        self.transport = transport.upper()
        self.endpoint = endpoint
        self.seq = seq
        self.payload_bytes = payload_bytes
        self.ts = ts
        self.pinned = pinned
        self.online = True


class Kalkul8Engine:
    def __init__(self, spreadsheet_id: str, worksheet_name: str, creds_file: str, total_slots: int = 64, stale_ttl: float = 30.0):
        self.seq = 41
        self.synced_total = 41
        self.pending_rows: list[list] = []
        self.ws = None
        self.sheets_ready = False
        self.total_slots = total_slots
        self.stale_ttl = stale_ttl
        self.slots: list[BufferBlock | None] = [None] * total_slots
        self.stats = {
            "passes": 0,
            "blocks_moved": 0,
            "stale_purged": 0,
            "fragmentation_before": 0.0,
            "fragmentation_after": 0.0,
        }
        self._init_sheets(spreadsheet_id, worksheet_name, creds_file)
        self._seed_slots()

    def _init_sheets(self, spreadsheet_id: str, worksheet_name: str, creds_file: str):
        if not os.path.exists(creds_file):
            print(f"[Sheets] '{creds_file}' not found; running in local/queued mode.")
            return
        try:
            creds = Credentials.from_service_account_file(creds_file, scopes=SCOPES)
            gc = gspread.authorize(creds)
            self.ws = gc.open_by_key(spreadsheet_id).worksheet(worksheet_name)
            self.sheets_ready = True
            print(f"[Sheets] Connected to worksheet '{worksheet_name}'.")
        except Exception as exc:
            print(f"[Sheets] Offline/queued mode ({exc})")

    def _seed_slots(self):
        self.allocate_slot("TIZEN", "192.168.1.50:8001", 1, 256, pinned=True)
        self.allocate_slot("APPLE_TV", "192.168.1.51:7000", 2, 256, pinned=True)
        self.allocate_slot("ETHERNET", "192.168.1.10:8888", 3, 1024, pinned=False)
        self.allocate_slot("WIFI", "192.168.1.25:8888", 4, 512, pinned=False)
        self.allocate_slot("BLE", "BLE:0x8525", 5, 68, pinned=False)

    def allocate_slot(self, transport: str, endpoint: str, seq: int, payload_bytes: int, pinned: bool = False) -> int:
        try:
            now = asyncio.get_running_loop().time()
        except RuntimeError:
            now = 0.0
        for idx, b in enumerate(self.slots):
            if b is None:
                self.slots[idx] = BufferBlock(idx, transport, endpoint, seq, payload_bytes, now, pinned)
                return idx
        for idx, b in enumerate(self.slots):
            if b and not b.pinned:
                self.slots[idx] = BufferBlock(idx, transport, endpoint, seq, payload_bytes, now, pinned)
                return idx
        return 0

    def _frag_pct(self) -> float:
        occ = [i for i, b in enumerate(self.slots) if b is not None]
        if len(occ) <= 1:
            return 0.0
        span = occ[-1] - occ[0] + 1
        return round(((span - len(occ)) / span) * 100.0, 2)

    async def defragment(self) -> dict:
        try:
            now = asyncio.get_running_loop().time()
        except RuntimeError:
            now = 0.0
        frag_before = self._frag_pct()
        purged = 0

        probes = {}
        for idx, b in enumerate(self.slots):
            if b and ":" in b.endpoint and not b.endpoint.startswith("BLE:"):
                host, port_s = b.endpoint.split(":", 1)
                probes[idx] = asyncio.create_task(check_tcp(host, int(port_s)))
        if probes:
            res = await asyncio.gather(*probes.values())
            for idx, ok in zip(probes.keys(), res):
                if self.slots[idx]:
                    self.slots[idx].online = ok

        active: list[BufferBlock] = []
        for b in self.slots:
            if b is None:
                continue
            if not b.pinned and now > 0 and (now - b.ts) > self.stale_ttl:
                purged += 1
            else:
                active.append(b)

        prio = {"ETHERNET": 0, "WIFI": 1, "TIZEN": 2, "APPLE_TV": 3, "BLE": 4}
        active.sort(key=lambda b: (prio.get(b.transport, 9), b.seq))

        new_slots: list[BufferBlock | None] = [None] * self.total_slots
        moved = 0
        for new_idx, b in enumerate(active):
            if b.slot_id != new_idx:
                moved += 1
            b.slot_id = new_idx
            new_slots[new_idx] = b

        self.slots = new_slots
        frag_after = self._frag_pct()
        self.stats.update({
            "passes": self.stats["passes"] + 1,
            "blocks_moved": self.stats["blocks_moved"] + moved,
            "stale_purged": self.stats["stale_purged"] + purged,
            "fragmentation_before": frag_before,
            "fragmentation_after": frag_after,
        })

        grid = []
        for idx, b in enumerate(self.slots):
            if b is None:
                grid.append({"slot": idx, "state": "FREE", "transport": None, "label": ".", "online": None})
            elif b.pinned:
                grid.append({"slot": idx, "state": "PINNED_SYS", "transport": b.transport, "endpoint": b.endpoint, "label": b.transport[0], "online": b.online})
            else:
                grid.append({"slot": idx, "state": "OPTIMIZED", "transport": b.transport, "endpoint": b.endpoint, "label": b.transport[0], "online": b.online})
        return {"stats": self.stats, "grid": grid}

    def ingest_packet(self, opcode: int, command: str) -> dict:
        body = struct.pack(">H", opcode & 0xFFFF) + command.encode("utf-8")
        frame = body + bytes([crc8(body)])
        parsed = decode_chip8_frame(frame)
        residual = round(abs(parsed["vy"] - (parsed["kalkul8_idx"] * 1.5)), 6)
        row = [
            parsed["timestamp_utc"],
            self.seq,
            parsed["vx"],
            parsed["vy"],
            parsed["kalkul8_idx"],
            parsed["ml_score"],
            residual,
        ]
        current_seq = self.seq
        self.seq += 1
        self.synced_total += 1
        self.pending_rows.append(row)
        self.allocate_slot("BLE", f"BLE:{parsed['opcode_hex']}", current_seq, len(frame), pinned=False)

        if len(self.pending_rows) >= 3:
            self.flush_sheets()

        parsed["seq"] = current_seq
        parsed["synced_total"] = self.synced_total
        parsed["sheets_live"] = self.sheets_ready
        parsed["queued_rows"] = len(self.pending_rows)
        return parsed

    def flush_sheets(self):
        if not self.pending_rows:
            return
        batch = self.pending_rows[:]
        self.pending_rows.clear()
        if self.ws:
            self.ws.append_rows(batch, value_input_option="USER_ENTERED")
            print(f"[Sheets] Appended {len(batch)} rows.")
        else:
            print(f"[Queue] Flushed {len(batch)} rows locally (connect service_account.json for live sheet write).")


