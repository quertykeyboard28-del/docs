def crc8(data: bytes) -> int:
    crc = 0
    for b in data:
        crc ^= b
    return crc


def sort_command_letters(raw_cmd: str) -> str:
    """Extracts and alphabetically sorts command characters for deterministic routing."""
    return "".join(sorted(ch for ch in raw_cmd if ch.isalpha())).upper()


def decode_chip8_admin_frame(frame: bytes) -> dict:
    """Parses [opcode: u16 BE][payload: utf-8][crc8: u8] and computes Kalkul8 ML metrics."""
    if len(frame) < 4:
        raise ValueError("BLE frame too short")
    body, rx_crc = frame[:-1], frame[-1]
    if crc8(body) != rx_crc:
        raise ValueError("CRC8 validation failed")

    (opcode,) = struct.unpack(">H", body[:2])
    payload_str = body[2:].decode("utf-8", errors="replace")
    sorted_key = sort_command_letters(payload_str)
    digest = hashlib.sha256(body).hexdigest()[:12]

    # Map 16-bit opcode nibbles (X, Y) into Kalkul8 ML feature space
    vx = float((opcode >> 8) & 0x0F)
    vy = float(opcode & 0x0F)
    k_idx = (vx * vy) / (abs(vx) + abs(vy) + 1.0)
    ml_score = math.tanh(k_idx)

    return {
        "timestamp_utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S"),
        "opcode_hex": f"0x{opcode:04X}",
        "corp": CORP_TAG,
        "raw_payload": payload_str,
        "sorted_letters": sorted_key,
        "sha256_prefix": digest,
        "vx": vx,
        "vy": vy,
        "kalkul8_idx": round(k_idx, 6),
        "ml_score": round(ml_score, 6),
    }


