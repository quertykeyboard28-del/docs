async def main_async(host: str, port: int, sheet_id: str, sheet_tab: str, creds_file: str):
    engine = Kalkul8Engine(sheet_id, sheet_tab, creds_file)
    app = web.Application()
    app["engine"] = engine
    app.router.add_get("/", handle_index)
    app.router.add_post("/api/admin/sync", handle_sync)
    app.router.add_post("/api/admin/flush", handle_flush)
    app.router.add_post("/api/admin/defrag", handle_defrag)

    runner = web.AppRunner(app)
    await runner.setup()
    site = web.TCPSite(runner, host, port)
    await site.start()
    print(f"[Ready] Open http://127.0.0.1:{port} (bound to {host}:{port})")

    asyncio.create_task(ble_listener(engine))
    try:
        while True:
            await asyncio.sleep(3600)
    finally:
        engine.flush_sheets()
        await runner.cleanup()


