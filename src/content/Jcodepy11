async def handle_sync(request: web.Request) -> web.Response:
    engine: Kalkul8Engine = request.app["engine"]
    payload = await request.json()
    opcode = int(payload.get("opcode", 0x8525))
    command = str(payload.get("command", "ICE_KRAM_KIIMI_WIN2000ME_OFFICE_ED"))
    result = engine.ingest_packet(opcode, command)
    return web.json_response({"status": "ok", "packet": result})


async def handle_flush(request: web.Request) -> web.Response:
    engine: Kalkul8Engine = request.app["engine"]
    queued_before = len(engine.pending_rows)
    engine.flush_sheets()
    return web.json_response({"status": "flushed", "rows_flushed": queued_before, "sheets_live": engine.sheets_ready})


async def handle_defrag(request: web.Request) -> web.Response:
    engine: Kalkul8Engine = request.app["engine"]
    report = await engine.defragment()
    return web.json_response(report)


async def ble_listener(engine: Kalkul8Engine):
