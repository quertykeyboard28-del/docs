BATCH_SIZE = 10


def crc8(data: bytes) -> int:
    crc = 0
    for b in data:
        crc ^= b
    return crc


def kalkul8_ml_transform(seq: int, x: float, y: float) -> list:
    """Computes Kalkul8 index, ML activation weight, and pyramid-normalized metric."""
    k_idx = (x * y) / (abs(x) + abs(y) + 1.0)
    ml_score = math.tanh(k_idx)
    residual = abs(y - (k_idx * 1.5))
    ts = datetime.datetime.now(datetime.timezone.utc).isoformat()
    return [ts, seq, round(x, 6), round(y, 6), round(k_idx, 6), round(ml_score, 6), round(residual, 6)]


class BleSheetsUploadEngine:
    def __init__(self):
        creds = Credentials.from_service_account_file(CREDS_FILE, scopes=SCOPES)
        gc = gspread.authorize(creds)
        self.sheet = gc.open_by_key(SPREADSHEET_ID)
        self.ws = self.sheet.worksheet(WORKSHEET_NAME)
        self.buffer: list[list] = []
        self._ensure_headers()

    def _ensure_headers(self):
        if not self.ws.row_values(1):
            self.ws.append_row(
                ["Timestamp_UTC", "Seq", "TI84_X", "TI84_Y", "Kalkul8_Idx", "ML_Score", "Residual"],
                value_input_option="USER_ENTERED",
            )

    def flush(self):
        if not self.buffer:
            return
        rows_to_push = self.buffer[:]
        self.buffer.clear()
        self.sheet.values_append(
            f"{WORKSHEET_NAME}!A1",
            {"valueInputOption": "USER_ENTERED"},
            {"values": rows_to_push},
        )
        print(f"[Sheets] Uploaded {len(rows_to_push)} rows.")

    def on_ble_notify(self, _sender: int, data: bytearray):
        if len(data) != 11:
            return
        body, rx_crc = bytes(data[:10]), data[10]
        if crc8(body) != rx_crc:
            print("[BLE] Dropped packet: CRC mismatch")
            return

        seq, x, y = struct.unpack("<Hff", body)
        row = kalkul8_ml_transform(seq, x, y)
        self.buffer.append(row)
        print(f"[BLE] seq={seq} x={x:.3f} y={y:.3f} -> ml={row[5]:.4f}")

        if len(self.buffer) >= BATCH_SIZE:
            self.flush()


async def main():
    engine = BleSheetsUploadEngine()
    print(f"Scanning for {DEVICE_NAME}...")
    device = await BleakScanner.find_device_by_name(DEVICE_NAME, timeout=15.0)
