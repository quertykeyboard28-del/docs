const char* WIFI_SSID = "YOUR_WIFI_SSID";
const char* WIFI_PASS = "YOUR_WIFI_PASSWORD";
const uint16_t SERVER_PORT = 8888;

// Button & Power/Auto-Press Pins (adjust to match your ESP32 / ESP32-S3 / C5 board)
static const uint8_t PIN_BOOT_BTN      = 0;   // Boot / Reboot button (active LOW)
static const uint8_t PIN_PWR_ON_BTN    = 4;   // Power-On button (active LOW with INPUT_PULLUP)
static const uint8_t PIN_PWR_LATCH_OUT = 5;   // Power-on / rail enable output (HIGH = ON)
static const uint8_t PIN_AUTO_BTN_OUT  = 6;   // AI Auto-Button Press pulse output

WebServer server(SERVER_PORT);

bool powerOnState = true;
bool aiAutoPressEnabled = true;
uint32_t seqCounter = 49;
uint32_t autoPressCount = 0;
String lastEvent = "BOOT_READY";

unsigned long lastBootBtnMs = 0;
unsigned long lastPwrBtnMs = 0;
unsigned long autoPressClearMs = 0;
bool autoPressActive = false;

void pulseAutoButton(uint16_t durationMs = 120) {
  if (!powerOnState) {
    powerOnState = true;
    digitalWrite(PIN_PWR_LATCH_OUT, HIGH);
  }
  digitalWrite(PIN_AUTO_BTN_OUT, HIGH);
  autoPressActive = true;
  autoPressClearMs = millis() + durationMs;
  autoPressCount++;
}

void triggerFirmwareSync(const String& sourceTag, const String& cmdPayload) {
  seqCounter++;
  lastEvent = "SYNC:" + sourceTag + ":" + cmdPayload;
  if (aiAutoPressEnabled) {
    pulseAutoButton(120);
  }
}

void handleButtons() {
  unsigned long now = millis();

  // 1. BOOT / REBOOT button (hold or press -> reboot)
  if (digitalRead(PIN_BOOT_BTN) == LOW && (now - lastBootBtnMs) > 350) {
    lastBootBtnMs = now;
    lastEvent = "REBOOT_BUTTON_PRESSED";
    Serial.println("[BOOT/REBOOT] Button pressed -> restarting ESP32...");
    delay(150);
    ESP.restart();
  }

  // 2. POWER-ON button (toggles power-on latch state)
  if (digitalRead(PIN_PWR_ON_BTN) == LOW && (now - lastPwrBtnMs) > 300) {
    lastPwrBtnMs = now;
    powerOnState = !powerOnState;
    digitalWrite(PIN_PWR_LATCH_OUT, powerOnState ? HIGH : LOW);
    lastEvent = powerOnState ? "POWER_ON_PRESSED" : "POWER_STANDBY_PRESSED";
    Serial.printf("[PWR] State -> %s\n", powerOnState ? "ON" : "STANDBY");
  }

  // 3. Auto-release AI auto-button press pin
  if (autoPressActive && (long)(now - autoPressClearMs) >= 0) {
    digitalWrite(PIN_AUTO_BTN_OUT, LOW);
    autoPressActive = false;
  }
}

void handleApiSync() {
  String body = server.hasArg("plain") ? server.arg("plain") : "{}";
  triggerFirmwareSync("HTTP_SYNC", body);
  String json = "{\"status\":\"synced\",\"seq\":" + String(seqCounter) +
                ",\"power_on\":" + String(powerOnState ? "true" : "false") +
                ",\"ai_auto_presses\":" + String(autoPressCount) +
                ",\"event\":\"" + lastEvent + "\"}";
  server.send(200, "application/json", json);
}

void handleApiPowerReboot() {
  String action = server.hasArg("action") ? server.arg("action") : "status";
  if (action == "power_on") {
    powerOnState = true;
    digitalWrite(PIN_PWR_LATCH_OUT, HIGH);
    lastEvent = "API_POWER_ON";
  } else if (action == "auto_press") {
    pulseAutoButton(150);
    lastEvent = "API_AI_AUTO_PRESS";
  } else if (action == "reboot") {
    server.send(200, "application/json", "{\"status\":\"rebooting\"}");
    delay(100);
    ESP.restart();
    return;
  }
  String json = "{\"power_on\":" + String(powerOnState ? "true" : "false") +
                ",\"ai_auto_presses\":" + String(autoPressCount) +
                ",\"seq\":" + String(seqCounter) +
                ",\"event\":\"" + lastEvent + "\"}";
  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);
  Serial1.begin(115200, SERIAL_8N1, 17, 18);

  pinMode(PIN_BOOT_BTN, INPUT_PULLUP);
  pinMode(PIN_PWR_ON_BTN, INPUT_PULLUP);
  pinMode(PIN_PWR_LATCH_OUT, OUTPUT);
  pinMode(PIN_AUTO_BTN_OUT, OUTPUT);

  // Power on immediately at boot
  powerOnState = true;
  digitalWrite(PIN_PWR_LATCH_OUT, HIGH);
  digitalWrite(PIN_AUTO_BTN_OUT, LOW);
  pulseAutoButton(100); // Initial AI boot auto-press check

  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long startMs = millis();
  while (WiFi.status() != WL_CONNECTED && (millis() - startMs) < 8000) {
    delay(250);
  }

  server.on("/api/admin/sync", HTTP_POST, handleApiSync);
  server.on("/api/admin/power", HTTP_ANY, handleApiPowerReboot);
  server.begin();
  Serial.printf("[ESP32] Ready on port %u | IP: %s\n", SERVER_PORT, WiFi.localIP().toString().c_str());
}

void loop() {
  handleButtons();
  server.handleClient();

  while (Serial1.available() > 0) {
    String line = Serial1.readStringUntil('\n');
    line.trim();
    if (line.length() > 0) {
      triggerFirmwareSync("UART1", line);
      Serial1.printf("{\"ack\":\"sync\",\"seq\":%u,\"auto_presses\":%u}\n",
                     seqCounter, autoPressCount);
    }
  }
}
